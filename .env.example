# ─────────────────────────────────────────────
# Smart Madrasa ERP v9.0 — Environment Variables
# cp .env.example .env এবং মান পূরণ করুন
# ─────────────────────────────────────────────

# ── Database (Required) ──
DATABASE_URL=postgresql://user:password@host:5432/madrasa_erp

# ── Security (Required) ──
# openssl rand -hex 32  দিয়ে তৈরি করুন
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-32-CHAR-STRING

# NID নম্বরের মতো sensitive field এনক্রিপ্ট করতে ব্যবহৃত হয় (Fernet key)।
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# এই key হারালে এনক্রিপ্ট করা সব NID নম্বর চিরতরে unrecoverable হয়ে যাবে —
# নিরাপদ জায়গায় ব্যাকআপ রাখুন (key rotation করলে পুরনো ডেটা re-encrypt করতে হবে)।
FIELD_ENCRYPTION_KEY=CHANGE-THIS-RUN-THE-COMMAND-ABOVE

# ── AI Analytics (Required for AI features) ──
# https://console.anthropic.com থেকে নিন
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Storage ──
STORAGE_PROVIDER=supabase          # supabase | s3 | local
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=your-key

# ── Payments ──
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs

# ── Notifications ──
WA_INSTANCE_ID=
WA_TOKEN=
SMS_API_KEY=

# ── App ──
APP_URL=https://your-app.streamlit.app
ENVIRONMENT=production
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Production Only ──
# bootstrap_schema() disable করতে (Alembic use করলে)
DISABLE_BOOTSTRAP=false

# ── Logging (নতুন) ──────────────────────────────────────────────
# production-এ json (log aggregator-এর জন্য), dev-এ text
LOG_FORMAT=text
LOG_LEVEL=INFO

# ── Backup (scripts/backup_db.sh) ───────────────────────────────
BACKUP_DIR=/var/backups/madrasa
BACKUP_KEEP=14

# ── CD Deploy (GitHub Secrets হিসেবে সেট করুন, .env-এ নয়) ──────
# DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY
# docker-compose.yml-এ image লাইন: image: ${MADRASA_IMAGE:-ghcr.io/<owner>/<repo>:latest}
