# ════════════════════════════════════════════════════
# Smart Madrasa ERP v9.0 — .gitignore
# ════════════════════════════════════════════════════

# ── Secrets & Credentials (CRITICAL — কখনো commit করবেন না) ──
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.toml
.streamlit/secrets.toml

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# ── Virtual Environments ──
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Testing ──
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
junit.xml
test-results/

# ── IDE & Editor ──
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ── Database ──
*.sqlite
*.sqlite3
*.db
*.db-journal
pg_dump_*.sql
backup_*.sql
backup_*.json
madrasa_backup_*.json
madrasa_backup_*.csv

# ── Logs ──
*.log
logs/
celery*.log
streamlit*.log
uvicorn*.log
error.log
access.log

# ── Docker volumes ──
postgres_data/
redis_data/
.docker/

# ── Uploads & Media ──
uploads/
media/
static/uploads/
/tmp/

# ── Node (যদি frontend যোগ হয়) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Streamlit cache ──
.streamlit/
!.streamlit/config.toml
!.streamlit/secrets.toml.template

# ── Alembic ──
migrations/versions/*.pyc

# ── OS ──
.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
Desktop.ini

# ── Temporary files ──
*.tmp
*.temp
*.bak
*.orig
*.rej

# ── Celery ──
celerybeat-schedule
celerybeat.pid

# ── Reports & Exports (generated files) ──
exports/
reports/generated/
*.xlsx
*.csv
!requirements*.txt
